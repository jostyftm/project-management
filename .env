# ==============================================================================
# ENTORNO LOCAL (Laravel Sail + Hot-Reload)
# Archivo de variables de entorno para docker-compose.yml
# ==============================================================================

# Puertos en Host (Entorno Local)
APP_PORT=8000
WEB_PORT=3010
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_RUSTFS_PORT=9100
FORWARD_RUSTFS_CONSOLE_PORT=9101
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# Configuración General de la Aplicación
APP_NAME="Project Management"
APP_ENV=local
APP_DEBUG=true

APP_KEY=base64:77w1jG1zH6jFeezeY67dY/viMzvlCFXwvcHlKFoeXyc=
APP_SERVICE=project_managment
COMPOSE_PROJECT_NAME=project

APP_URL=http://localhost:${APP_PORT}
FRONTEND_URL=http://localhost:${WEB_PORT}

APP_LOCALE=es
APP_TIMEZONE=America/Bogota

# Laravel Sail & Permisos
WWWUSER=1000
WWWGROUP=1000
LARAVEL_SAIL=1
SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG=client_host=host.docker.internal
IGNITION_LOCAL_SITES_PATH=/var/www/html

# Base de Datos PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=project
DB_USERNAME=sdiuser_pro
DB_PASSWORD=secret_password

# Variables del contenedor PostgreSQL (Reutilizadas)
POSTGRES_DB=${DB_DATABASE}
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}

# Redis (Caché & Colas)
SESSION_DRIVER=file
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=secret_password
REDIS_PORT=6379
REDIS_PREFIX=project_cache_
REDIS_CACHE_DB=8
REDIS_DB=8

# Colas
QUEUE_CONNECTION=redis

#Broadcast
BROADCAST_CONNECTION=log

# Filesystem (Almacenamiento de Archivos)
FILESYSTEM_DISK=s3

# Almacenamiento S3 con RustFS
RUSTFS_VOLUMES=/data
RUSTFS_ADDRESS=0.0.0.0:9000
RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_EXTERNAL_ADDRESS=:9000
RUSTFS_CORS_ALLOWED_ORIGINS=*
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=*
RUSTFS_ACCESS_KEY=sail
RUSTFS_SECRET_KEY=password
RUSTFS_LOG_LEVEL=info
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=sail
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_URL=http://localhost:${FORWARD_RUSTFS_PORT}/${RUSTFS_BUCKET}
RUSTFS_USE_PATH_STYLE_ENDPOINT=true

# Compatibilidad con clientes AWS S3 (Reutilizadas de RustFS)
AWS_ACCESS_KEY_ID=${RUSTFS_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${RUSTFS_SECRET_KEY}
AWS_DEFAULT_REGION=${RUSTFS_REGION}
AWS_BUCKET=${RUSTFS_BUCKET}
AWS_ENDPOINT=${RUSTFS_ENDPOINT}
AWS_URL=${RUSTFS_URL}
AWS_USE_PATH_STYLE_ENDPOINT=${RUSTFS_USE_PATH_STYLE_ENDPOINT}

# Correo Local (Mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Web Next.js (Reutilizadas de APP_URL)
NEXT_PUBLIC_API_URL=${APP_URL}
NEXT_PUBLIC_REPORT_API_URL=${APP_URL}
NEXT_PUBLIC_LOGIN_ROUTE=/login
NEXT_PUBLIC_ENVIRONMENT=development
