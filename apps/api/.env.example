# SDI Auth Service Integration (Personalizable por entorno)
SDI_AUTH_SERVICE_URL=http://sdi_auth-service
SDI_AUTH_APPLICATION_ID=9
SDI_AUTH_USERS_ENDPOINT=/api/v1/applications/{application_id}/users
AUTH_BYPASS=false

# Configuración de Laravel Sail en Monorepo
SAIL_FILES=../../docker-compose.yml
