APP_NAME="Project Management"
APP_ENV=local
APP_KEY=base64:77w1jG1zH6jFeezeY67dY/viMzvlCFXwvcHlKFoeXyc=
APP_DEBUG=true

APP_SERVICE=project_managment
APP_PORT=8000
APP_URL=http://localhost:8000
APP_URL_PROD=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=es
APP_TIMEZONE=America/Bogota
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=project
DB_USERNAME=sdiuser_pro
DB_PASSWORD=secret_password
# DB_SCHEMA=public

POSTGRES_DB=${DB_DATABASE}
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=rustfs
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CACHE_DB=1
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=secret_password
REDIS_PORT=6379
REDIS_PREFIX=project_cache_
REDIS_DB=0

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=${RUSTFS_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${RUSTFS_SECRET_KEY}
AWS_DEFAULT_REGION=${RUSTFS_REGION}
AWS_BUCKET=${RUSTFS_BUCKET}
AWS_ENDPOINT=${RUSTFS_ENDPOINT}
AWS_URL=${RUSTFS_URL}
AWS_USE_PATH_STYLE_ENDPOINT=true

RUSTFS_ACCESS_KEY=sail
RUSTFS_SECRET_KEY=password
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=sail
RUSTFS_URL=http://localhost:9100/sail
FORWARD_RUSTFS_PORT=9100
FORWARD_RUSTFS_CONSOLE_PORT=9101
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_USE_PATH_STYLE_ENDPOINT=true

# SDI Auth Service Integration (Personalizable por entorno)
SDI_AUTH_SERVICE_URL=http://sdi_auth-service
SDI_AUTH_APPLICATION_ID=9
SDI_AUTH_USERS_ENDPOINT=/api/v1/applications/{application_id}/users
AUTH_BYPASS=false

# Configuración de Laravel Sail en Monorepo
SAIL_FILES=../../docker-compose.yml
COMPOSE_FILE=../../docker-compose.yml
COMPOSE_PROJECT_NAME=project
