# ==========================================
# Etapa 1: Base (Debian Bookworm para estabilidad con OCI8 y Kafka)
# ==========================================
FROM php:8.4-fpm-bookworm AS base

# Instalar Nginx, Supervisor, Chromium, Node.js y dependencias esenciales (incluyendo libaio1 para Oracle)
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    supervisor \
    git \
    unzip \
    curl \
    gnupg \
    libaio1 \
    chromium \
    && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g --allow-scripts=puppeteer puppeteer \
    && curl -sSLf -o /usr/local/bin/install-php-extensions https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions \
    && chmod +x /usr/local/bin/install-php-extensions \
    && rm -rf /var/lib/apt/lists/*

# Instalar todas las extensiones requeridas por Laravel, Yajra Oracle y exportación de reportes
RUN install-php-extensions \
    pdo_pgsql \
    pgsql \
    pdo_mysql \
    gd \
    zip \
    bcmath \
    pcntl \
    opcache \
    redis \
    rdkafka \
    opentelemetry \
    oci8 \
    pdo_oci \
    exif

# Configurar OPcache para PRODUCCIÓN (validate_timestamps=0)
RUN echo "opcache.enable=1\nopcache.enable_cli=1\nopcache.jit=tracing\nopcache.jit_buffer_size=256M\nopcache.validate_timestamps=0\nopcache.interned_strings_buffer=16\nopcache.max_accelerated_files=10000" > /usr/local/etc/php/conf.d/opcache-recommended.ini

# ==========================================
# Etapa 2: Build (Dependencias de Producción)
# ==========================================
FROM base AS build

# Copiar Composer desde la imagen oficial
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copiar archivos de dependencias para aprovechar el caché
COPY composer.json composer.lock ./

# Instalación exclusiva para PRODUCCIÓN (--no-dev)
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --ignore-platform-reqs

# Copiar el resto de la aplicación
COPY . .

# Limpiar manifiestos y cachés residuales antes de generar el autoloader
RUN rm -f bootstrap/cache/*.php

# Autoloader optimizado para producción
RUN composer dump-autoload --no-dev --optimize --classmap-authoritative

# ==========================================
# Etapa 3: Producción Inmutable
# ==========================================
FROM base AS production

WORKDIR /var/www/html

# Copiar el build compilado
COPY --from=build --chown=www-data:www-data /var/www/html /var/www/html

# Crear carpetas de Laravel si no existen (con los permisos correctos)
RUN mkdir -p storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    storage/logs \
    bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Copiar configuraciones de Nginx, Supervisor y PHP
COPY ./deploy/prod/nginx.conf /etc/nginx/nginx.conf
COPY ./deploy/prod/supervisord.conf /etc/supervisord.conf
COPY ./deploy/prod/php.ini /usr/local/etc/php/conf.d/99-custom-limits.ini

# Limpiar herramientas de compilación en producción para aligerar la imagen
RUN rm /usr/local/bin/install-php-extensions

EXPOSE 80

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisord.conf"]