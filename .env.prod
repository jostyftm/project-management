# ==============================================================================
# ENTORNO PRODUCCIÓN (Optimizado / Inmutable)
# Archivo de variables de entorno para docker-compose-prod.yml
# ==============================================================================

# Puertos en Host (Entorno Producción)
PROD_GATEWAY_PORT=80
PROD_APP_PORT=8002
PROD_WEB_PORT=3002
PROD_DB_PORT=5434
PROD_REDIS_PORT=6381
PROD_RUSTFS_PORT=9300
PROD_RUSTFS_CONSOLE_PORT=9301

# Configuración General de la Aplicación
APP_NAME="Project Management"
APP_ENV=production
APP_KEY=base64:77w1jG1zH6jFeezeY67dY/viMzvlCFXwvcHlKFoeXyc=
APP_DEBUG=false
APP_URL=http://localhost:${PROD_APP_PORT}
APP_LOCALE=es
APP_TIMEZONE=America/Bogota

# Base de Datos PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres_prod
DB_PORT=5432
DB_DATABASE=project_prod
DB_USERNAME=sdiuser_pro
DB_PASSWORD=secret_password

# Variables del contenedor PostgreSQL (Reutilizadas)
POSTGRES_DB=${DB_DATABASE}
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}

# Redis (Caché & Colas con Autenticación)
REDIS_CLIENT=predis
REDIS_HOST=redis_prod
REDIS_PASSWORD=secret_password
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file

# Almacenamiento S3 con RustFS
FILESYSTEM_DISK=rustfs
RUSTFS_VOLUMES=/data
RUSTFS_ADDRESS=0.0.0.0:9000
RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_EXTERNAL_ADDRESS=:9000
RUSTFS_ACCESS_KEY=sail
RUSTFS_SECRET_KEY=password
RUSTFS_LOG_LEVEL=warn
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=sail
RUSTFS_ENDPOINT=http://rustfs_prod:9000
RUSTFS_URL=http://localhost:${PROD_RUSTFS_PORT}/${RUSTFS_BUCKET}
RUSTFS_USE_PATH_STYLE_ENDPOINT=true

# Compatibilidad con clientes AWS S3 (Reutilizadas de RustFS)
AWS_ACCESS_KEY_ID=${RUSTFS_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${RUSTFS_SECRET_KEY}
AWS_DEFAULT_REGION=${RUSTFS_REGION}
AWS_BUCKET=${RUSTFS_BUCKET}
AWS_ENDPOINT=${RUSTFS_ENDPOINT}
AWS_URL=${RUSTFS_URL}
AWS_USE_PATH_STYLE_ENDPOINT=${RUSTFS_USE_PATH_STYLE_ENDPOINT}

# Correo en Producción
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Web Next.js (Reutilizadas de APP_URL)
NEXT_PUBLIC_API_URL=${APP_URL}
NEXT_PUBLIC_REPORT_API_URL=${APP_URL}
NEXT_PUBLIC_LOGIN_ROUTE=/login
NEXT_PUBLIC_ENVIRONMENT=production
