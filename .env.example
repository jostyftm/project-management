# ==============================================================================
# Monorepo Environment Configuration (Local, Dev, Prod)
# ==============================================================================

# Entorno activo: local | development | production
APP_ENV=local
COMPOSE_PROJECT_NAME=project

# Puertos - Entorno Local (docker-compose.yml)
APP_PORT=8000
WEB_PORT=3000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_RUSTFS_PORT=9100
FORWARD_RUSTFS_CONSOLE_PORT=9101
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# Puertos - Entorno Dev (docker-compose-dev.yml)
DEV_APP_PORT=8001
DEV_WEB_PORT=3001
DEV_DB_PORT=5433
DEV_REDIS_PORT=6380
DEV_RUSTFS_PORT=9200
DEV_RUSTFS_CONSOLE_PORT=9201
DEV_MAILPIT_PORT=1026
DEV_MAILPIT_DASHBOARD_PORT=8026

# Puertos - Entorno Prod (docker-compose-prod.yml)
PROD_APP_PORT=8002
PROD_WEB_PORT=3002
PROD_DB_PORT=5434
PROD_REDIS_PORT=6381
PROD_RUSTFS_PORT=9300
PROD_RUSTFS_CONSOLE_PORT=9301

# Gateway Ports (Acceso unificado App y API en mismo dominio e IP)
PROD_GATEWAY_PORT=80
DEV_GATEWAY_PORT=80

# URLs Dinámicas y Reutilizadas
APP_URL=http://localhost:${PROD_GATEWAY_PORT}
FRONTEND_URL=${APP_URL}
# Dejar vacío para rutas relativas same-origin en mismo dominio/puerto
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_REPORT_API_URL=

# Base de datos PostgreSQL (Reutilización DRY)
DB_DATABASE=project
DB_USERNAME=sdiuser_pro
DB_PASSWORD=secret_password
POSTGRES_DB=${DB_DATABASE}
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}

# Redis
REDIS_PASSWORD=secret_password

# RustFS & AWS S3 (Reutilización DRY)
RUSTFS_ACCESS_KEY=sail
RUSTFS_SECRET_KEY=password
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=sail
RUSTFS_URL=http://localhost:${FORWARD_RUSTFS_PORT}/${RUSTFS_BUCKET}
RUSTFS_USE_PATH_STYLE_ENDPOINT=true

AWS_ACCESS_KEY_ID=${RUSTFS_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${RUSTFS_SECRET_KEY}
AWS_DEFAULT_REGION=${RUSTFS_REGION}
AWS_BUCKET=${RUSTFS_BUCKET}
AWS_ENDPOINT=http://rustfs:9000
AWS_URL=${RUSTFS_URL}
AWS_USE_PATH_STYLE_ENDPOINT=${RUSTFS_USE_PATH_STYLE_ENDPOINT}

# Permisos de Usuario para Docker (Sail)
WWWUSER=1000
WWWGROUP=1000
SAIL_XDEBUG_MODE=off
