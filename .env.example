# ==============================================================================
# Monorepo Environment Configuration (Canonical Template)
# ==============================================================================

# Entorno activo: local | development | production
APP_NAME="Project Management"
APP_SERVICE=project_managment
APP_ENV=local
APP_KEY=base64:77w1jG1zH6jFeezeY67dY/viMzvlCFXwvcHlKFoeXyc=
APP_DEBUG=true
COMPOSE_PROJECT_NAME=project

# URLs Principales
APP_URL=http://localhost:8000
APP_URL_PROD=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Localización e Idioma
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=America/Bogota
APP_MAINTENANCE_DRIVER=file

# Rendimiento y Seguridad
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging y Depuración
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Puertos en Host - Entorno Local (docker-compose.yml)
APP_PORT=8000
WEB_PORT=3000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_RUSTFS_PORT=9100
FORWARD_RUSTFS_CONSOLE_PORT=9101
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# Puertos en Host - Entorno Dev (docker-compose-dev.yml)
DEV_GATEWAY_PORT=80
DEV_APP_PORT=8001
DEV_WEB_PORT=3001
DEV_DB_PORT=5433
DEV_REDIS_PORT=6380
DEV_RUSTFS_PORT=9200
DEV_RUSTFS_CONSOLE_PORT=9201
DEV_MAILPIT_PORT=1026
DEV_MAILPIT_DASHBOARD_PORT=8026

# Puertos en Host - Entorno Prod (docker-compose-prod.yml)
PROD_GATEWAY_PORT=80
PROD_APP_PORT=8002
PROD_WEB_PORT=3002
PROD_DB_PORT=5434
PROD_REDIS_PORT=6381
PROD_RUSTFS_PORT=9300
PROD_RUSTFS_CONSOLE_PORT=9301

# Base de Datos PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=project
DB_USERNAME=sdiuser_pro
DB_PASSWORD=secret_password

# Variables del contenedor PostgreSQL (Reutilizadas)
POSTGRES_DB=${DB_DATABASE}
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}

# Redis (Caché & Colas)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=secret_password
REDIS_PORT=6379
REDIS_PREFIX=project_cache_
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
MEMCACHED_HOST=127.0.0.1

# Sesiones de Usuario
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Almacenamiento de Archivos S3 (MinIO en local / AWS S3 en producción)
FILESYSTEM_DISK=s3
RUSTFS_VOLUMES=/data
RUSTFS_ADDRESS=0.0.0.0:9000
RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_EXTERNAL_ADDRESS=:9000
RUSTFS_CORS_ALLOWED_ORIGINS=*
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=*
RUSTFS_ACCESS_KEY=phvIoUxNjCkt5nB6X8WG
RUSTFS_SECRET_KEY=CPJorh2lJVTf45jWEolV4xlTPtmwhprUfWp8otZx
RUSTFS_LOG_LEVEL=info
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=project
RUSTFS_ENDPOINT=http://minio:9000
RUSTFS_URL=http://localhost:9000/project
RUSTFS_USE_PATH_STYLE_ENDPOINT=true

# Compatibilidad con clientes AWS S3
AWS_ACCESS_KEY_ID=${RUSTFS_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${RUSTFS_SECRET_KEY}
AWS_DEFAULT_REGION=${RUSTFS_REGION}
AWS_BUCKET=${RUSTFS_BUCKET}
AWS_ENDPOINT=${RUSTFS_ENDPOINT}
AWS_URL=${RUSTFS_URL}
AWS_USE_PATH_STYLE_ENDPOINT=${RUSTFS_USE_PATH_STYLE_ENDPOINT}
AWS_THROW=true

# Correo Electrónico
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SDI Auth Service Integration
SDI_AUTH_SERVICE_URL=http://sdi_auth-service
SDI_AUTH_APPLICATION_ID=9
SDI_AUTH_USERS_ENDPOINT=/api/v1/applications/{application_id}/users
AUTH_BYPASS=false

# Frontend Web Next.js
# (Dejar vacío para rutas relativas same-origin en mismo dominio/puerto con Nginx Gateway)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_REPORT_API_URL=
NEXT_PUBLIC_LOGIN_ROUTE=/login
NEXT_PUBLIC_ENVIRONMENT=development
